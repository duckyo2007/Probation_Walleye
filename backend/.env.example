# Sao chép thành .env nếu muốn đổi cấu hình. KHÔNG commit file .env.
# Chạy với .env:  uvicorn app.main:app --reload --env-file .env

# Các origin được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Thư mục chứa file JSON (mặc định: backend/data)
# EASYPLAN_DATA_DIR=

# Số giây tối thiểu giữa 2 lần nhắc học cho cùng một task
INACTIVITY_COOLDOWN_SECONDS=300

# Chưa được dùng: tutor và Google Calendar đang là mock.
# LLM_API_KEY=
# GOOGLE_CALENDAR_CREDENTIALS=
